# Copy to .env.local and fill in. Never commit .env.local.
# See docs/VERCEL-DEPLOY.md for where to get each key.

# United States ISOs (CISO/ERCO/ISNE/PJM/NYIS/MISO). Free key.
# https://www.eia.gov/opendata/register.php
EBB_EIA_API_KEY=

# European Network of Transmission System Operators for Electricity.
# Free token via the Transparency Platform "My Account → Web API".
# https://transparency.entsoe.eu/
EBB_ENTSOE_SECURITY_TOKEN=

# Universal fallback for any zone not covered by EIA / ENTSO-E / GB.
# Free developer tier, 100 requests / day.
# https://www.electricitymaps.com/free-tier-api
EBB_ELECTRICITY_MAPS_API_KEY=
