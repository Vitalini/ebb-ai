// Build settings of the "Tidegap Safari Extension" appex target (U20). The
// version and signing come from Base.xcconfig, so the appex matches the app.
#include "Base.xcconfig"

PRODUCT_NAME = Tidegap Safari Extension
PRODUCT_MODULE_NAME = TidegapSafariExtension
PRODUCT_BUNDLE_IDENTIFIER = com.tidegap.mac.safari-extension
INFOPLIST_FILE = SafariExtension/Info.plist
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_CFBundleDisplayName = Tidegap
CODE_SIGN_ENTITLEMENTS = SafariExtension/SafariExtension.entitlements
ENABLE_APP_SANDBOX = YES
ASSETCATALOG_COMPILER_APPICON_NAME =
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME =
SKIP_INSTALL = YES
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks @executable_path/../../../../Frameworks
