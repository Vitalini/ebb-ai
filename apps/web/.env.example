# Copy to .env.local and fill in. Never commit .env.local.
# See docs/VERCEL-DEPLOY.md for where to get each key.
#
# SCOPE: these variables configure a HOST — this dashboard, the `ebb` CLI, and
# the `@ebb-ai/mcp` server. Each host reads them at its own entry point and
# injects them into `@ebb-ai/core`, which is environment-pure.
#
# The `@vitalini/ebb` OpenClaw plugin reads NO environment variables. Configure
# it under `plugins.entries.ebb.config` in your OpenClaw gateway config:
#   EBB_EIA_API_KEY              -> eiaApiKey
#   WATTTIME_USERNAME            -> wattTimeUsername
#   WATTTIME_PASSWORD            -> wattTimePassword
#   EBB_ENTSOE_SECURITY_TOKEN    -> entsoeSecurityToken
#   EBB_ELECTRICITY_MAPS_API_KEY -> electricityMapsApiKey
# OpenClaw resolves the "${ENV_VAR}" shorthand in those fields, so you can keep
# exporting the same variables and let the gateway read them for the plugin.

# United States ISOs (CISO/ERCO/ISNE/PJM/NYIS/MISO). Free key.
# Average-emissions intensity. https://www.eia.gov/opendata/register.php
EBB_EIA_API_KEY=

# WattTime v3 — MARGINAL-emissions (co2_moer) forecasts for the US ISOs.
# Takes precedence over EIA where covered; falls through to EIA on error.
# Free account at https://watttime.org/
WATTTIME_USERNAME=
WATTTIME_PASSWORD=

# European Network of Transmission System Operators for Electricity.
# Free token via the Transparency Platform "My Account → Web API".
# https://transparency.entsoe.eu/
EBB_ENTSOE_SECURITY_TOKEN=

# Universal fallback for any zone not covered by EIA / ENTSO-E / GB.
# Free developer tier, 100 requests / day.
# https://www.electricitymaps.com/free-tier-api
EBB_ELECTRICITY_MAPS_API_KEY=
