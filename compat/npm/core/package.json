{
  "name": "@ebb-ai/core",
  "version": "0.17.1",
  "description": "Renamed to @tidegap/core. This package re-exports it and stops receiving updates.",
  "license": "Apache-2.0",
  "author": "Vitalii Borovyk",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": { "types": "./index.d.ts", "import": "./index.js" },
    "./grid": { "types": "./grid.d.ts", "import": "./grid.js" },
    "./energy": { "types": "./energy.d.ts", "import": "./energy.js" },
    "./types": { "types": "./types.d.ts", "import": "./types.js" },
    "./package.json": "./package.json"
  },
  "files": ["*.js", "*.d.ts", "README.md"],
  "dependencies": {
    "@tidegap/core": "^0.18.0"
  },
  "engines": { "node": ">=20" },
  "repository": { "type": "git", "url": "https://github.com/tidegap/tidegap.git", "directory": "compat/npm/core" },
  "homepage": "https://www.tidegap.com"
}
