{
  "name": "@ebb-ai/cli",
  "version": "0.9.0",
  "description": "CLI for ebb-ai \u2014 cron-tick drain, launchd install, and sleep-prevention for the carbon-aware scheduler.",
  "license": "Apache-2.0",
  "author": "Vitalii Borovyk",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "ebb": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ebb-ai/core": "workspace:*",
    "commander": "^12.1.0"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.32.0",
    "openai": ">=4.70.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.5",
    "@types/node": "^22.10.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Vitalini/ebb-ai.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  }
}
