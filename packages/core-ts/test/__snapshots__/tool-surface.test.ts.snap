      "params": [
        {
          "description": "Optional. If set, cancel only tasks in this status. Valid: 'queued', 'scheduled'. Defaults to both.",
          "kind": "enum",
          "name": "status",
          "required": false,
          "values": [
            "queued",
            "scheduled",
          ],
        },
      ],
    },
    {
      "description": "Set or change how a scheduled task's result is delivered when it completes. Call this right after schedule_task, once you have ASKED the user how they want the result. The user may pick several modes. Modes: chat (their active OpenClaw chat), telegram, webhook (needs webhook_url), file (needs file_path; format md/html/txt/json/pdf), queue (no push — retrievable via check_queue_status), os (a native desktop notification on the gateway host). PRIVACY BOUNDARY — chat and queue keep the result inside OpenClaw; webhook POSTs the FULL result to whatever URL is supplied (ebb does not restrict or inspect that destination), telegram sends the FULL result to a third-party service, and file writes it to any path on the gateway host. Never pick one of those three on the user's behalf: confirm the destination with them first, and for sensitive tasks prefer chat or queue. Default if the user is unsure: chat.",
      "name": "set_delivery",
      "params": [
        {
          "description": "The id returned by schedule_task.",
          "kind": "string",
          "minLength": 1,
          "name": "task_id",
          "required": true,
        },
        {
          "description": "One or more delivery modes the user chose.",
          "itemKind": "enum",
          "kind": "array",
          "name": "deliver",
          "required": true,
          "values": [
            "chat",
            "telegram",
            "webhook",
            "file",
            "queue",
            "os",
          ],
        },
        {
          "description": "Target URL when deliver includes 'webhook'.",
          "kind": "string",
          "name": "webhook_url",
          "required": false,
        },
        {
          "description": "Output path when deliver includes 'file'.",
          "kind": "string",
          "name": "file_path",
          "required": false,
        },
        {
          "description": "Report format for 'file' delivery: md, html, txt, json, or pdf (pdf renders the HTML report via puppeteer if installed on the gateway). Default: md.",
          "kind": "enum",
          "name": "file_format",
          "required": false,
          "values": [
            "md",
            "html",
            "txt",
            "json",
            "pdf",
          ],
        },
      ],
    },
  ],
}
`;
