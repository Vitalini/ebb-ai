{
  "name": "@vitalini/ebb-ai",
  "version": "0.1.1",
  "description": "OpenClaw plugin: auto-defer \"do it later\" / \"by tomorrow\" / \"overnight\" tasks to the cleanest electricity-grid hour inside a deadline. Native OpenClaw tools for carbon-aware AI workflow scheduling. Shares ~/.ebb-ai/queue.db with the ebb-ai MCP server and CLI.",
  "license": "Apache-2.0",
  "author": "Vitalii Borovyk",
  "homepage": "https://www.ebb-ai.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/Vitalini/ebb-ai.git",
    "directory": "packages/openclaw-plugin"
  },
  "type": "module",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "openclaw": {
    "extensions": ["./dist/index.js"],
    "compat": {
      "pluginApi": ">=2026.3.24-beta.2",
      "minGatewayVersion": "2026.3.24-beta.2"
    },
    "build": {
      "openclawVersion": "2026.3.24-beta.2",
      "pluginSdkVersion": "2026.3.24-beta.2"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ebb-ai/core": "^0.8.2"
  },
  "peerDependencies": {
    "typebox": ">=0.32.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^22.10.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
